# Example environment configuration.
# Copy this file to .env and replace the placeholders with real values on your own machine.
# .env is listed in .gitignore and must never be committed.
# This repository contains documentation only; these variables show the pattern a project would use.

APP_ENV=development
API_BASE_URL=https://api.example.com
API_KEY=replace-with-your-api-key
DATABASE_URL=replace-with-your-database-url
